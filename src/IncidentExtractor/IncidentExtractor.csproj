<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The key/value ONNX model is ~280 MB; a 32-bit process cannot allocate it ("bad allocation"). -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.5" />
    <PackageReference Include="Syncfusion.EJ2.Spreadsheet.AspNet.Core" Version="100.2.1" />
    <PackageReference Include="Syncfusion.ImagePreProcessor.Net.Core" Version="100.2.36" />
    <PackageReference Include="Syncfusion.Licensing" Version="100.2.10" />
    <PackageReference Include="Syncfusion.MetafileRenderer.Net.Core" Version="100.2.1641" />
    <PackageReference Include="Syncfusion.Pdf.Imaging.Net.Core" Version="100.2.1657" />
    <PackageReference Include="Syncfusion.SkiaSharpHelper.Net.Core" Version="100.2.1586" />
    <PackageReference Include="Syncfusion.SmartDataExtractor.Net.Core" Version="100.2.89" />
    <PackageReference Include="Syncfusion.XlsIORenderer.Net.Core" Version="100.2.1668" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="web.config" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="runtimes\models\syncfusion_doclayout.onnx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="runtimes\models\syncfusion_key_value_pair_detection.onnx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="runtimes\models\syncfusion_sentencepiece.model">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="runtimes\tessdata\eng.traineddata">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="runtimes\win-x64\native\5.0\leptonica-1.85.0.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="runtimes\win-x64\native\5.0\libSyncfusionTesseract.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>



</Project>
