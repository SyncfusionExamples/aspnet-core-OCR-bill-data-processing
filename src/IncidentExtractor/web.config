<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service (Windows / IIS) virtual-application hosting.
  Publish this app as a virtual application or virtual directory named
  aspnet-core-ocr-bill-data-processing. ASPNETCORE_PATHBASE must match PathBase
  in appsettings.json so the ASP.NET Core pipeline strips the prefix.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\IncidentExtractor.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_PATHBASE" value="/aspnet-core-ocr-bill-data-processing" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
